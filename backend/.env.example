# Sao chép thành .env rồi điền giá trị thật. File .env KHÔNG được đưa lên Git.
PHISHGUARD_MONGO_URI=mongodb://localhost:27017
PHISHGUARD_GEMINI_API_KEY=
PHISHGUARD_GEMINI_MODEL=gemini-flash-lite-latest
# Số lần gọi /analyze tối đa mỗi phút cho một IP (0 = không giới hạn)
PHISHGUARD_RATE_LIMIT_PER_MINUTE=30
# Mã đăng nhập trang /dashboard (để trống = khóa trang quản trị)
PHISHGUARD_ADMIN_TOKEN=
# Google Safe Browsing API key (không bắt buộc)
PHISHGUARD_SAFE_BROWSING_KEY=
