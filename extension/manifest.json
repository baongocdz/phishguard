{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "0.2.0",
  "description": "Phát hiện và cảnh báo phishing theo thời gian thực.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishGuard",
    "default_popup": "popup.html"
  }
}
